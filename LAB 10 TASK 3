#include <iostream>
using namespace std;

int findMax(int arr[], int size)
{
    if (size == 1)
        return arr[0];

    int maxFromRest = findMax(arr, size - 1);

    if (arr[size - 1] > maxFromRest)
        return arr[size - 1];
    else
        return maxFromRest;
}

int main()
{
    int arr[1000];
    int size;
    cout << "Enter the size ";
    cin >> size;


    cout << "Enter the elements :";
    for (int i = 0; i < size; i++)
    {
        cin >> arr[i];
    }

    cout << findMax(arr, size);

    return 0;
}
